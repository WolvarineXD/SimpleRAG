# LLM Provider Configuration
# Options: anthropic, openai, gemini, groq
LLM_PROVIDER=groq

# Get your Groq API key from: https://console.groq.com/
LLM_API_KEY=your_groq_api_key_here

# Recommended Groq models (sorted by capability):
# - llama-3.3-70b-versatile (RECOMMENDED) - Best balance of speed and quality
# - llama-3.1-70b-versatile - Great for general tasks
# - mixtral-8x7b-32768 - Good for longer contexts
# - llama-3.1-8b-instant - Fastest, lower quality
LLM_MODEL=llama-3.3-70b-versatile

# Alternative providers (uncomment to use):
# Anthropic:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your_key_here
# LLM_MODEL=claude-3-5-sonnet-20241022

# OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your_key_here
# LLM_MODEL=gpt-4o

# Google Gemini:
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_key_here
# LLM_MODEL=gemini-pro
